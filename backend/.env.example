# Local dev uses SQLite by default; no value needed.
# For Neon, paste the connection string from the Neon dashboard:
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./habits.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production

# Comma-separated, and must match the browser's Origin exactly: scheme + host
# (+ port). No trailing slash, no quotes - though both are stripped if present.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. A regex for hosts that mint a new URL per deploy, so Vercel preview
# builds keep working without editing CORS_ORIGINS every time:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
