# Leave unset for local dev - the Vite proxy forwards /api to 127.0.0.1:8000.
# In production set this to your Render URL, with no trailing slash:
# VITE_API_URL=https://habit-tracker-api.onrender.com

# Dev only: where `npm run dev` forwards /api. Defaults to http://127.0.0.1:8000.
# Set this in .env.local if you run the API on another port.
# VITE_API_PROXY=http://127.0.0.1:8001
